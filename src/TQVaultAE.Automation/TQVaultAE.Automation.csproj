<Project Sdk="Microsoft.NET.Sdk">

	<!-- Code shared by the Debug automation endpoints of TQVaultAE and ARZExplorer (headless mode, UI thread access,
	     control walks). Both apps reference it in Debug builds only, so their Release builds carry none of it.
	     See documentation/AUTOMATION.md -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>TQVaultAE.Automation</RootNamespace>
		<AssemblyName>TQVaultAE.Automation</AssemblyName>
		<Platforms>AnyCPU;x64;x86</Platforms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseWindowsForms>true</UseWindowsForms>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<NoWarn>$(NoWarn);WFO1000</NoWarn>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

</Project>
